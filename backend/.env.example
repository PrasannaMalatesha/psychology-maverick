# Copy to .env for local runs. Tests do not use this file — they spin up an
# ephemeral pgvector container and inject the URL.

# Storage (ADR-0001)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/maverick

# Retrieval / answer policy
RETRIEVAL_TOP_K=5
GROUNDING_THRESHOLD=0.5

# Model gateway roles (ADR-0002) — wired to the real adapter in T3
EMBEDDING_MODEL=bge-small-en-v1.5
SYNTHESIS_MODEL=gpt-4o-mini
